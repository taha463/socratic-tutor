# ==========================================
# Socratic Tutor v2 - Environment Configuration
# ==========================================

# 1. Cloud Provider Keys (Recommended for Visual Socratic Tutor)
# Primary High-Speed Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Secondary High-Capacity Fallback Provider (OpenRouter)
# When Groq reaches token-per-minute limits, the LLM Gateway auto-cascades to OpenRouter free models
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
OPEN_ROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Optional Provider Priority Order (comma-separated: groq,openrouter)
LLM_PROVIDER_ORDER=groq,openrouter

# 2. Local Ollama (Free, runs locally, no key required)
# Install from https://ollama.ai then run: ollama run llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. Additional Cloud Provider Keys (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 4. Storage & Server Configuration
DATABASE_PATH=data/tutor.db
NEXT_PUBLIC_API_URL=http://localhost:3000
FASTAPI_SKETCH_URL=http://localhost:8000
