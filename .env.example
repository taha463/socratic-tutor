# ==========================================
# Socratic Tutor v2 - Environment Configuration
# ==========================================

# 1. LLM Provider Selection
# Options: "mock" (default, runs tests/offline with no key), "ollama", "anthropic", "openai", "gemini"
LLM_PROVIDER=mock

# 2. Local Ollama (Free, runs locally, no key required)
# Install from https://ollama.ai then run: ollama run llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. Cloud Provider Keys (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here

# 4. Storage Configuration
DATABASE_PATH=data/tutor.db

# 5. Optional Manim Plugin (Disabled by default)
SOCRATIC_ENABLE_MANIM=false
