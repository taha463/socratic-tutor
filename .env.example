# Socratic Tutor v2 Configuration

# LLM Provider: "mock", "anthropic", "gemini", or "openai"
LLM_PROVIDER=mock

# API Keys (required only when LLM_PROVIDER is not "mock")
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model overrides (optional)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini

# Database and file storage paths
SOCRATIC_DB_PATH=.socratic/socratic.db
SOCRATIC_VISUALS_DIR=.socratic/visuals

# Web Adapter Port
SOCRATIC_PORT=8000
